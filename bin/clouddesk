#!/usr/bin/env bash
# CloudDesk-RDP helper CLI — installed to /usr/local/bin/clouddesk.
# Small, dependency-free front end for the xrdp services.

set -o pipefail

VERSION="1.0.0"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_G=$'\033[1;32m'; C_Y=$'\033[1;33m'; C_R=$'\033[1;31m'; C_B=$'\033[1;36m'; C_0=$'\033[0m'
else
    C_G=""; C_Y=""; C_R=""; C_B=""; C_0=""
fi

info()  { printf '%s[i]%s %s\n' "$C_B" "$C_0" "$*"; }
ok()    { printf '%s[+]%s %s\n' "$C_G" "$C_0" "$*"; }
warn()  { printf '%s[!]%s %s\n' "$C_Y" "$C_0" "$*"; }
err()   { printf '%s[x]%s %s\n' "$C_R" "$C_0" "$*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        err "This command must run as root (try: sudo clouddesk ...)"
        exit 1
    fi
}

svc_active() {
    if have systemctl && [ -d /run/systemd/system ]; then
        systemctl is-active --quiet "$1" && return 0
        return 1
    fi
    pgrep -x "$1" >/dev/null 2>&1
}

cmd_status() {
    local state_x state_s port
    if have systemctl && [ -d /run/systemd/system ]; then
        state_x="$(systemctl is-active xrdp 2>/dev/null || echo inactive)"
        state_s="$(systemctl is-active xrdp-sesman 2>/dev/null || echo inactive)"
        printf '%s xrdp         : %s\n' "$(label "$state_x")" "$state_x"
        printf '%s xrdp-sesman  : %s\n' "$(label "$state_s")" "$state_s"
    else
        if pgrep -x xrdp >/dev/null 2>&1; then state_x="running"; else state_x="stopped"; fi
        if pgrep -x xrdp-sesman >/dev/null 2>&1; then state_s="running"; else state_s="stopped"; fi
        printf '%s xrdp         : %s\n' "$(label "$state_x")" "$state_x"
        printf '%s xrdp-sesman  : %s\n' "$(label "$state_s")" "$state_s"
    fi

    if have ss; then
        if ss -tln 2>/dev/null | grep -q ':3389 '; then
            ok "RDP port 3389 : listening"
            port="yes"
        else
            warn "RDP port 3389 : NOT listening"
            port="no"
        fi
    else
        warn "ss(8) not available; cannot check port 3389"
        port="unknown"
    fi

    if [ "${state_x}" = "active" ] || [ "${state_x}" = "running" ]; then
        if [ "$port" = "yes" ]; then
            ok "CloudDesk-RDP looks healthy. Connect with your RDP client to <server-ip>:3389"
        fi
    else
        warn "xrdp is not running. Try: sudo clouddesk start   or   sudo clouddesk logs"
    fi
}

label() {
    case "$1" in
        active|running)  printf '%sOK%s'   "$C_G" "$C_0" ;;
        inactive|failed|stopped) printf '%sDOWN%s' "$C_R" "$C_0" ;;
        *)               printf '%s??%s'   "$C_Y" "$C_0" ;;
    esac
}

cmd_start() {
    require_root
    info "Starting xrdp..."
    if have systemctl && [ -d /run/systemd/system ]; then
        systemctl start xrdp.service xrdp-sesman.service
    else
        mkdir -p /var/run/xrdp 2>/dev/null || true
        chown xrdp:xrdp /var/run/xrdp 2>/dev/null || true
        xrdp-sesman 2>/dev/null || true
        sleep 1
        xrdp 2>/dev/null || true
    fi
    cmd_status
}

cmd_stop() {
    require_root
    info "Stopping xrdp..."
    if have systemctl && [ -d /run/systemd/system ]; then
        systemctl stop xrdp.service xrdp-sesman.service
    else
        pkill -x xrdp 2>/dev/null || true
        pkill -x xrdp-sesman 2>/dev/null || true
    fi
    ok "Stopped."
}

cmd_restart() {
    require_root
    info "Restarting xrdp..."
    if have systemctl && [ -d /run/systemd/system ]; then
        systemctl restart xrdp.service xrdp-sesman.service
    else
        cmd_stop
        sleep 1
        cmd_start
        return
    fi
    cmd_status
}

cmd_logs() {
    local which="${1:-all}"
    case "$which" in
        xrdp)
            if have systemctl && [ -d /run/systemd/system ]; then
                journalctl -u xrdp -n 100 --no-pager
            else
                tail -n 100 /var/log/xrdp.log 2>/dev/null || err "No /var/log/xrdp.log"
            fi
            ;;
        sesman)
            if have systemctl && [ -d /run/systemd/system ]; then
                journalctl -u xrdp-sesman -n 100 --no-pager
            else
                tail -n 100 /var/log/xrdp-sesman.log 2>/dev/null || err "No /var/log/xrdp-sesman.log"
            fi
            ;;
        install)
            tail -n 100 /var/log/clouddesk-install.log 2>/dev/null || err "No install log found"
            ;;
        all|--all|"")
            if have systemctl && [ -d /run/systemd/system ]; then
                journalctl -u xrdp -u xrdp-sesman -n 100 --no-pager
            else
                tail -n 50 /var/log/xrdp-sesman.log 2>/dev/null || true
                tail -n 50 /var/log/xrdp.log 2>/dev/null || err "No xrdp logs found"
            fi
            ;;
        *)
            err "Unknown log target: $which (use: all | xrdp | sesman | install)"
            exit 1
            ;;
    esac
}

cmd_info() {
    info "CloudDesk-RDP ${VERSION}"
    echo "  RDP port        : 3389 (TCP)"
    echo "  Desktop session : XFCE (started via /etc/xrdp/startwm.sh)"
    echo "  Assets          : /usr/share/clouddesk"
    echo "  Manifest        : /var/lib/clouddesk/manifest"
    echo "  Backups         : /var/backups/clouddesk/"
    echo "  Install log     : /var/log/clouddesk-install.log"
    echo "  Uninstall       : sudo $(dirname "$(readlink -f "$0" 2>/dev/null || echo .)")/../..  (see README: uninstall.sh)"
}

cmd_help() {
    cat <<EOF
CloudDesk-RDP helper — version ${VERSION}

Usage: clouddesk <command>

Commands:
  status            Show xrdp/sesman status and RDP port
  start             Start the RDP services
  stop              Stop the RDP services
  restart           Restart the RDP services
  logs [target]     Show logs: all (default) | xrdp | sesman | install
  info              Show installation paths and info
  version           Print version
  help              This help
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        status)   cmd_status ;;
        start)    cmd_start ;;
        stop)     cmd_stop ;;
        restart)  cmd_restart ;;
        logs)     cmd_logs "$@" ;;
        info)     cmd_info ;;
        version|--version|-V) echo "CloudDesk-RDP ${VERSION}" ;;
        help|--help|-h) cmd_help ;;
        *)
            err "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
